# docker compose 配置（复制为 .env 并填写真实值）
# 只是本地测试？用 dev-only 的 .env.local 更省事：见 .env.local 与 scripts/run_local.py。
POSTGRES_PASSWORD=change-me

# Steam 配置（Publisher Web API Key、AppID、票据 identity）不在环境变量里：
# 它们按游戏存放在数据库中，登录管理端后在「Steam 凭据」与「游戏」页面配置。
# 全新部署的数据库里没有游戏，因此管理员登录后会被强制跳到「添加游戏」页。

# JWT 配置（签名密钥至少 32 字符）
JWT_ISSUER=GameFeedback
JWT_AUDIENCE=GameFeedbackClient
JWT_SIGNING_KEY=

# 首个管理员账号（仅在数据库无管理员时创建）
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=

# Cloudflare Tunnel Token（可选；如果服务器有 Cloudflare Tunnel 可配置）
CLOUD_FLARE_TUNNEL_TOKEN=

# 应用看到的可信代理来源 IP；Docker 转发可能显示为网桥网关，需按实际拓扑设置。
# 留空只信任回环代理，不接受任意来源的 X-Forwarded-For / X-Forwarded-Proto。
REVERSE_PROXY_IP=

# Swagger UI（生产环境默认关闭；开启会暴露 API 结构，仅限受信网络/内网调试）
SWAGGER_ENABLED=false

# 调试开关：跳过 Steam 验票（登录时用 debugSteamId 直接声明 SteamID64）。
# 只能在 ASPNETCORE_ENVIRONMENT=Development 时启用，否则应用拒绝启动。
STEAM_DEBUG_SKIP=false

# Data Protection key ring 的落盘目录（加密 Steam 密钥用）。
# 生产由 compose 固定为容器内 /app/keys 并挂持久卷；这个卷必须纳入备份——
# 丢了它，已存的 Steam 凭据将永久无法解密。
DATAPROTECTION_KEYS_PATH=
