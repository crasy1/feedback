{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=gamefeedback;Username=gamefeedback;Password=<postgres-password>"
  },
  "Database": {
    "AutoMigrate": true
  },
  "Swagger": {
    "Enabled": false
  },
  "ReverseProxy": {
    "KnownProxies": []
  },
  "Steam": {
    "DebugSkipTicketValidation": false
  },
  "DataProtection": {
    "KeysPath": "/app/keys"
  },
  "Jwt": {
    "Issuer": "GameFeedback",
    "Audience": "GameFeedbackClient",
    "SigningKey": "<at-least-256-bit-signing-key>"
  },
  "Admin": {
    "SeedEmail": "admin@example.com",
    "SeedPassword": "<admin-password>"
  }
}
