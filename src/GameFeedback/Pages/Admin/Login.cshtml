@page
@model GameFeedback.RazorPages.Admin.LoginModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>管理员登录 - 游戏反馈系统</title>
    @* 登录页是独立 HTML（Layout = null），不经过 App.razor，所以要自己引入共享样式表。 *@
    <link rel="stylesheet" href="/admin.css" />
</head>
<body class="admin-login">
    <div class="card">
        <h1>游戏反馈系统 · 管理员登录</h1>
        <form method="post">
            <label asp-for="Email">邮箱</label>
            <input asp-for="Email" autocomplete="username" />
            <label asp-for="Password">密码</label>
            <input asp-for="Password" type="password" autocomplete="current-password" />
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <p class="error">@Model.ErrorMessage</p>
            }
            <button type="submit" class="primary">登录</button>
        </form>
    </div>
</body>
</html>
