{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // Steam 的票据与 Publisher Key 都在查询串里传递。运行时会把查询串脱敏成 "?*"，
      // 但那条硬不变量（绝不记录票据/密钥）不该依赖别人的默认行为——这里直接把
      // HttpClient 的请求日志压到 Warning。
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*"
}
