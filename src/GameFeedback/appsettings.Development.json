{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=gamefeedback;Username=gamefeedback;Password=change-me"
  },
  "Steam": {
    "DebugSkipTicketValidation": true
  },
  "Jwt": {
    "Issuer": "GameFeedback",
    "Audience": "GameFeedbackClient",
    "SigningKey": "dev-only-signing-key-0123456789abcdef0123456789abcdef"
  },
  "Admin": {
    "SeedEmail": "admin@example.com",
    "SeedPassword": "Admin12345"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // 同 appsettings.json：Steam 票据与 Key 走查询串，不依赖运行时脱敏。
      "System.Net.Http.HttpClient": "Warning"
    }
  }
}
