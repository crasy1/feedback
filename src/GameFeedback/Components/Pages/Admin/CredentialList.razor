@page "/admin/credentials"
@layout GameFeedback.Components.Layout.AdminLayout
@using GameFeedback.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject SteamCredentialService Credentials

<PageTitle>Steam 凭据 - 游戏反馈系统</PageTitle>

<h1>Steam 凭据</h1>

<p class="note">
    Publisher Web API Key 以密文存放在数据库里，<b>界面不回显、日志不记录</b>。
    一份凭据可以服务多个游戏（同一个发行商 Key 覆盖它名下的全部 AppID），所以轮换密钥是改一处。
    密钥是手工粘贴的，粘错的表现和「Steam 挂了」一模一样——保存后请用「验证」确认一次。
</p>

@if (_error is not null)
{
    <p class="error">@_error</p>
}
@if (_message is not null)
{
    <p class="note">@_message</p>
}

<div class="filter-actions">
    <a class="button-link primary" href="/admin/credentials/new">添加凭据</a>
</div>

@if (_credentials is null)
{
    <p class="state">加载中…</p>
}
else if (_credentials.Count == 0)
{
    <p class="state">还没有任何 Steam 凭据。游戏必须先选一份凭据才能接受登录。</p>
}
else
{
    <div class="table-scroll">
        <table class="feedback-table">
            <thead>
                <tr>
                    <th>名称</th>
                    <th>被游戏引用</th>
                    <th>创建时间 (UTC)</th>
                    <th>操作</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var credential in _credentials)
                {
                    <tr>
                        <td>@credential.Name</td>
                        <td>@credential.GameCount</td>
                        <td>@credential.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="actions-cell">
                            <a href="/admin/credentials/@credential.Id/edit">编辑</a>
                            <button @onclick="() => VerifyAsync(credential.Id)">验证</button>
                            @if (_pendingDeleteId == credential.Id)
                            {
                                <button class="danger" @onclick="() => DeleteAsync(credential.Id)">确认删除</button>
                                <button @onclick="() => _pendingDeleteId = null">取消</button>
                            }
                            else
                            {
                                <button @onclick="() => _pendingDeleteId = credential.Id">删除</button>
                            }
                        </td>
                    </tr>
                    @if (_probeMessages.TryGetValue(credential.Id, out var probe))
                    {
                        <tr>
                            <td colspan="4" class="probe-row">@probe</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

@code {
    private IReadOnlyList<CredentialAdminView>? _credentials;
    private readonly Dictionary<int, string> _probeMessages = [];
    private int? _pendingDeleteId;
    private string? _error;
    private string? _message;

    protected override async Task OnParametersSetAsync()
    {
        _pendingDeleteId = null;
        _probeMessages.Clear();
        await ReloadAsync();
    }

    private async Task ReloadAsync() => _credentials = await Credentials.ListAsync(CancellationToken.None);

    private async Task VerifyAsync(int id)
    {
        _error = null;
        _message = null;

        var result = await Credentials.VerifyAsync(id, CancellationToken.None);
        // 探测只带回结论，密钥本身永远不会出现在这里。
        _probeMessages[id] = $"探测结果：{result.Message}";
    }

    private async Task DeleteAsync(int id)
    {
        _error = null;
        _message = null;
        _pendingDeleteId = null;

        switch (await Credentials.DeleteAsync(id, CancellationToken.None))
        {
            case CredentialDeleteOutcome.Deleted:
                _message = "凭据已删除。";
                break;
            case CredentialDeleteOutcome.InUse:
                _error = "这份凭据仍被某个游戏引用，不能删除。请先改掉那些游戏的凭据选择。";
                break;
            case CredentialDeleteOutcome.NotFound:
                _error = "凭据不存在。";
                break;
        }

        await ReloadAsync();
    }
}
