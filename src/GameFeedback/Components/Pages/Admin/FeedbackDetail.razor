@page "/admin/feedback/{Id:int}"
@layout GameFeedback.Components.Layout.AdminLayout
@using System.Security.Claims
@using GameFeedback.Domain
@using GameFeedback.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize]
@inject AdminFeedbackService AdminFeedbacks
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>反馈详情 - 游戏反馈系统</PageTitle>

@if (_feedback is null)
{
    <p class="state">加载中…</p>
}
else
{
    <h1>@_feedback.Title</h1>

    <section class="meta">
        <dl>
            <dt>类型</dt>
            <dd><span class="badge @FeedbackTypeDisplay.GetCssClass(_feedback.Type)">@_feedback.Type</span></dd>

            <dt>状态</dt>
            <dd><span class="badge @FeedbackStatusDisplay.GetCssClass(_feedback.Status)">@FeedbackStatusDisplay.GetText(_feedback.Status)</span></dd>

            <dt>玩家</dt>
            <dd>
                <div class="player-cell">
                    @if (!string.IsNullOrWhiteSpace(_feedback.Player?.AvatarUrl))
                    {
                        <img class="player-avatar" src="@_feedback.Player.AvatarUrl" alt="玩家头像" width="32" height="32" />
                    }
                    <span>@(_feedback.Player?.SteamName ?? "未知")</span>
                </div>
            </dd>

            <dt>SteamID64</dt>
            <dd>
                @(_feedback.Player?.SteamId ?? "—")
                @if (!string.IsNullOrWhiteSpace(_feedback.Player?.SteamId))
                {
                    <a href="https://steamcommunity.com/profiles/@_feedback.Player.SteamId" target="_blank" rel="noopener">Steam 个人资料</a>
                    <a href="/admin/feedback?player=@_feedback.Player.SteamId">查看该玩家全部反馈</a>
                }
            </dd>

            <dt>游戏版本</dt>
            <dd>@(_feedback.GameVersion ?? "—")　构建号 @(_feedback.BuildNumber ?? "—")</dd>

            <dt>操作系统</dt>
            <dd>@(_feedback.OperatingSystem ?? "—")</dd>

            <dt>CPU</dt>
            <dd>@(_feedback.Cpu ?? "—")</dd>

            <dt>GPU</dt>
            <dd>@(_feedback.Gpu ?? "—")</dd>

            <dt>内存</dt>
            <dd>@FormatMemory(_feedback.MemoryTotalMb)</dd>

            <dt>游玩时长</dt>
            <dd>@FormatPlaytime(_feedback.PlaytimeMinutes)</dd>

            <dt>语言 / 地图 / 角色</dt>
            <dd>@(_feedback.Locale ?? "—")　@(_feedback.Map ?? "—")　@(_feedback.Character ?? "—")</dd>

            <dt>创建时间 (UTC)</dt>
            <dd>@_feedback.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>
        </dl>
    </section>

    <section class="content">
        <h2>反馈内容</h2>
        <pre>@_feedback.Content</pre>
    </section>

    <section class="comments">
        <h2>评论 (@_feedback.Comments.Count)</h2>
        @foreach (var comment in _feedback.Comments)
        {
            <div class="comment">
                <span class="author">@(comment.AuthorType == CommentAuthorType.Admin ? "管理员" : "玩家")</span>
                <span class="time">@comment.CreatedAt.ToString("yyyy-MM-dd HH:mm") UTC</span>
                <p>@comment.Content</p>
            </div>
        }
    </section>

    <section class="actions">
        <h2>回复</h2>
        <textarea @bind="ReplyText" rows="4" placeholder="输入回复内容…"></textarea>
        @if (!string.IsNullOrEmpty(_actionError))
        {
            <p class="error">@_actionError</p>
        }
        <button class="primary" @onclick="SubmitReply">发送回复</button>

        <h2>状态</h2>
        <select @bind="SelectedStatus">
            @foreach (var status in Enum.GetValues<FeedbackStatus>())
            {
                <option value="@status">@FeedbackStatusDisplay.GetText(status)</option>
            }
        </select>
        <button class="primary" @onclick="ChangeStatus">更新状态</button>
    </section>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private GameFeedback.Domain.Feedback? _feedback;
    private string? ReplyText { get; set; }
    private string SelectedStatus { get; set; } = "Open";
    private string? _actionError;

    protected override async Task OnParametersSetAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _feedback = await AdminFeedbacks.GetAsync(Id, CancellationToken.None);
        if (_feedback is not null)
        {
            SelectedStatus = _feedback.Status.ToString();
        }
    }

    private async Task SubmitReply()
    {
        _actionError = null;
        var error = FeedbackService.ValidateComment(ReplyText);
        if (error is not null)
        {
            _actionError = error;
            return;
        }

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var adminUserId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "unknown-admin";

        await AdminFeedbacks.ReplyAsync(adminUserId, Id, ReplyText!.Trim(), CancellationToken.None);
        ReplyText = null;
        await ReloadAsync();
    }

    private async Task ChangeStatus()
    {
        _actionError = null;
        var status = Enum.Parse<FeedbackStatus>(SelectedStatus);
        if (!await AdminFeedbacks.ChangeStatusAsync(Id, status, CancellationToken.None))
        {
            _actionError = $"反馈 #{Id} 不存在，状态未更改。";
            return;
        }

        await ReloadAsync();
    }

    /// <summary>物理内存总量按 MB 入库，展示时换算成 GB。</summary>
    private static string FormatMemory(int? memoryTotalMb)
    {
        if (memoryTotalMb is not int mb)
        {
            return "—";
        }

        return mb >= 1024 ? $"{mb / 1024.0:0.#} GB" : $"{mb} MB";
    }

    /// <summary>游玩时长以分钟入库（Steam 原生单位），展示时换算。</summary>
    private static string FormatPlaytime(int? minutes)
    {
        if (minutes is not int value)
        {
            return "—";
        }

        return value < 60 ? $"{value} 分钟" : $"{value / 60.0:0.#} 小时";
    }
}
