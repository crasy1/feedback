@page "/admin/credentials/new"
@page "/admin/credentials/{Id:int}/edit"
@layout GameFeedback.Components.Layout.AdminLayout
@using GameFeedback.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject SteamCredentialService Credentials
@inject NavigationManager Navigation

<PageTitle>@(IsNew ? "添加凭据" : "编辑凭据") - 游戏反馈系统</PageTitle>

<h1>@(IsNew ? "添加 Steam 凭据" : "编辑 Steam 凭据")</h1>

<p class="note">
    密钥以密文入库，界面永远不会把它读回来显示。编辑时<b>留空即表示不修改密钥</b>。
</p>

@if (_error is not null)
{
    <p class="error">@_error</p>
}
@if (_loadError is not null)
{
    <p class="error">@_loadError</p>
}

@if (!_loaded)
{
    <p class="state">加载中…</p>
}
else
{
    <section class="actions">
        <label>
            名称
            <input @bind="_name" placeholder="如 发行商主密钥" maxlength="100" />
        </label>

        <label>
            Publisher Web API Key
            @* 永不回显：type=password、不预填、关掉自动填充。 *@
            <input type="password" autocomplete="off" spellcheck="false"
                   @bind="_apiKey"
                   placeholder="@(IsNew ? "粘贴密钥" : "留空表示不修改")" />
        </label>

        <div class="filter-actions">
            <button class="primary" @onclick="SaveAsync">保存</button>
            <a class="button-link" href="/admin/credentials">返回</a>
        </div>
    </section>
}

@code {
    [Parameter]
    public int? Id { get; set; }

    private bool IsNew => Id is null;

    private bool _loaded;
    private string _name = string.Empty;
    private string _apiKey = string.Empty;
    private string? _error;
    private string? _loadError;

    protected override async Task OnParametersSetAsync()
    {
        _loaded = false;
        _loadError = null;

        if (!IsNew)
        {
            var credential = await Credentials.GetAsync(Id!.Value, CancellationToken.None);
            if (credential is null)
            {
                _loadError = "凭据不存在。";
                return;
            }

            _name = credential.Name;
            // 密钥刻意不加载：它是只写的。
            _apiKey = string.Empty;
        }

        _loaded = true;
    }

    private async Task SaveAsync()
    {
        _error = null;

        var result = IsNew
            ? await Credentials.CreateAsync(_name, _apiKey, CancellationToken.None)
            : await Credentials.UpdateAsync(Id!.Value, _name, _apiKey, CancellationToken.None);

        if (!result.Succeeded)
        {
            _error = result.Error;
            return;
        }

        Navigation.NavigateTo("/admin/credentials");
    }
}
