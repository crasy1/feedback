<Project Sdk="Godot.NET.Sdk/4.7.2">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GdFeedbackHost</RootNamespace>
    <AssemblyName>GdFeedbackHost</AssemblyName>
    <!--
      这里刻意不设 TreatWarningsAsErrors：本工程同时编译第三方 vendored 插件
      （addons/steamworks 有 ~49 条既存告警：CS8618/CS8625/CS8602…），把告警当错误会让
      宿主根本无法构建。真实宿主 arena.csproj 同样不设该开关。
      gd_feedback 自己的严格门禁在 addons/gd_feedback/tests/verify.py 第 4 阶段（干净宿主 fixture + 0 warning）。
    -->
    <!-- NU1900 只是"离线时取不到 NuGet 漏洞数据"，与代码无关，静音以免每次都刷屏。 -->
    <NoWarn>$(NoWarn);NU1900</NoWarn>
  </PropertyGroup>

  <!--
    不需要任何 Compile 项：addons/ 下的插件由 Godot.NET.Sdk 的默认 glob 编进来 —— 与真实宿主一致。
    godottools 这两个包是 vendored 的 steamworks 插件需要的（它用 Chickensoft 的源生成器 +
    Facepunch.Steamworks 等）；gd_feedback 本身零第三方依赖。
  -->
  <ItemGroup>
    <PackageReference Include="godottools" Version="0.0.7" />
    <PackageReference Include="godottools.sourcegenerators" Version="0.0.7" />
  </ItemGroup>
</Project>
